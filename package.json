{
  "name": "derstandard-enhancer",
  "version": "0.1.8",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "bun build.js",
    "check:dist": "bun build.js --check",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check:quality": "biome check .",
    "test:unit": "bun test tests/storage.test.js tests/site.test.js tests/comments.test.js",
    "test:browser": "playwright test tests/controller.test.js",
    "verify": "bun run check:quality && bun run check:dist && bun run test:unit && bun run test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "1.52.0"
  }
}
